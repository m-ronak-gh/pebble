import "math.pb";

function number main() {
    print abs(-42);
    print abs(42);
    print min(10, 20);
    print max(10, 20);

    decimal s sqrt(25.0);
    print s;

    decimal p pow(2.0, 8.0);
    print p;

    decimal fl floor(3.9);
    print fl;

    decimal ce ceil(3.1);
    print ce;

    return 0;
}
